PORT=3000
SESSION_SECRET=change_me_to_a_long_random_string

# Optional email verification (recommended)
# If not set, the app will still work, but it will show the verification code on-screen after registration.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=you@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM="SVSU AI Hub <no-reply@svsu.edu>"
